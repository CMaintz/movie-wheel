# --- Local development only (VITE_ prefix = embedded in client bundle) ---
# Required for dev: TMDB API v3 key (https://www.themoviedb.org/settings/api)
VITE_TMDB_API_KEY=
# Optional for dev: TMDB v4 read access token (for watch provider data)
VITE_TMDB_READ_TOKEN=

# --- Vercel production (set in Vercel dashboard > Settings > Environment Variables) ---
# TMDB_API_KEY=       (no VITE_ prefix - stays server-side)
# TMDB_READ_TOKEN=    (no VITE_ prefix - stays server-side)
