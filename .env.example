# --- Local development only (VITE_ prefix = embedded in the dev bundle) ---
# Required for `npm run dev`: TMDB API v3 key (https://www.themoviedb.org/settings/api)
VITE_TMDB_API_KEY=
# Optional: TMDB v4 read access token (used for watch provider data)
VITE_TMDB_READ_TOKEN=

# --- Production (server-side only, never VITE_-prefixed) ---
# Cloudflare Workers: `npx wrangler secret put TMDB_API_KEY` (and optionally TMDB_READ_TOKEN);
#   for `wrangler dev`, put them in .dev.vars (git-ignored).
# Vercel: set TMDB_API_KEY / TMDB_READ_TOKEN / ALLOWED_ORIGINS in Project Settings > Environment Variables.
