{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movie-wheel",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  // Static SPA from `vite build`; only /api/* reaches the Worker code.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Cross-origin callers allowed besides the Worker's own origin (comma-separated).
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173"
  },
  // TMDB_API_KEY (required) and TMDB_READ_TOKEN (optional) are secrets: `npx wrangler secret put TMDB_API_KEY`
  "ratelimits": [
    {
      "name": "TMDB_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
